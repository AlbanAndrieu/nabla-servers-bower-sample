<?xml version="1.0" encoding="UTF-8"?>
<!-- Opt-in private mirror: ./mvnw <goal> -s settings.xml, used by the CI and the Dockerfile when Nexus answers -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">

  <servers>
    <!-- nexus.albandrieu.com is behind Cloudflare Access: CI authenticates with a service token -->
    <server>
      <id>nexus</id>
      <configuration>
        <httpHeaders>
          <property>
            <name>CF-Access-Client-Id</name>
            <value>${env.CF_ACCESS_CLIENT_ID}</value>
          </property>
          <property>
            <name>CF-Access-Client-Secret</name>
            <value>${env.CF_ACCESS_CLIENT_SECRET}</value>
          </property>
        </httpHeaders>
      </configuration>
    </server>
  </servers>

  <mirrors>
    <mirror>
      <id>nexus</id>
      <mirrorOf>*</mirrorOf>
      <url>https://nexus.albandrieu.com/repository/maven-public/</url>
    </mirror>
  </mirrors>

</settings>
