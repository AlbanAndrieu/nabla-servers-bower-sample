<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                      https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
  version="6.0">

  <display-name>sample</display-name>
  <description>Sample Application</description>

  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
  </welcome-file-list>

   <servlet>
        <servlet-name>com.test.project.sample.servlet.MyApplication</servlet-name>
        <servlet-class>org.glassfish.jersey.servlet.ServletContainer</servlet-class>
        <init-param>
            <param-name>jakarta.ws.rs.Application</param-name>
            <param-value>com.test.project.sample.MyApplication</param-value>
        </init-param>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>com.test.project.sample.servlet.MyApplication</servlet-name>
        <url-pattern>/rest/*</url-pattern>
    </servlet-mapping>

    <servlet>
       <servlet-name>proxy-login</servlet-name>
       <!-- <servlet-class>com.test.project.sample.LoginProxyServlet$Transparent</servlet-class>-->
       <servlet-class>org.eclipse.jetty.ee10.proxy.ProxyServlet$Transparent</servlet-class>
       <!-- <async-supported>true</async-supported> -->

       <init-param>
         <param-name>proxyTo</param-name>
         <param-value>http://home.nabla.mobi:8080/login</param-value>
       </init-param>

       <init-param>
         <param-name>prefix</param-name>
         <param-value>/login</param-value>
       </init-param>

       <load-on-startup>1</load-on-startup>
   </servlet>

   <servlet-mapping>
       <servlet-name>proxy-login</servlet-name>
       <url-pattern>/login/*</url-pattern>
   </servlet-mapping>

    <servlet>
       <servlet-name>proxy-apidocs</servlet-name>
       <!-- <servlet-class>com.test.project.sample.LoginProxyServlet$Transparent</servlet-class>-->
       <servlet-class>org.eclipse.jetty.ee10.proxy.ProxyServlet$Transparent</servlet-class>
       <!-- <async-supported>true</async-supported> -->

       <init-param>
         <param-name>proxyTo</param-name>
         <param-value>http://home.nabla.mobi:8080/apidocs</param-value>
       </init-param>

       <init-param>
         <param-name>prefix</param-name>
         <param-value>/apidocs</param-value>
       </init-param>

       <load-on-startup>1</load-on-startup>
   </servlet>

   <servlet-mapping>
       <servlet-name>proxy-apidocs</servlet-name>
       <url-pattern>/apidocs/*</url-pattern>
   </servlet-mapping>

   <!-- disable directory listing -->
   <servlet>
       <servlet-name>default</servlet-name>
       <servlet-class>org.eclipse.jetty.ee10.servlet.DefaultServlet</servlet-class>
       <init-param>
           <param-name>dirAllowed</param-name>
           <param-value>false</param-value>
       </init-param>
   </servlet>

   <!-- gzip, DoS and QoS are Jetty 12 server modules (compression-gzip, dos, qos), see Dockerfile -->

