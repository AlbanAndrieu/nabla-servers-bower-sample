    ],
    "rules": {
      "plugin/no-unsupported-browser-features": true
    },
    "defaultSeverity": "warning"
  },
  "dependencies": {
    "angular": "1.8.3",
    "angular-animate": "1.8.3",
    "angular-cookies": "1.8.3",
    "angular-dynamic-locale": "0.1.38",
    "angular-gravatar": "0.4.2",
    "angular-i18n": "1.8.3",
    "angular-resource": "1.8.3",
    "angular-route": "1.8.3",
    "angular-sanitize": "1.8.3",
    "angular-touch": "1.8.3",
    "angular-translate": "2.19.1",
    "angular-translate-handler-log": "2.19.1",
    "angular-translate-loader-static-files": "2.19.1",
    "angular-translate-storage-cookie": "2.19.1",
    "angular-translate-storage-local": "2.19.1",
    "angular-ui-bootstrap": "2.5.6",
    "bootstrap-sass": "3.4.3",
    "font-awesome": "4.7.0",
    "github-fork-ribbon-css": "0.2.3",
    "jquery": "3.7.1",
    "jquery-ui": "1.14.2",
    "sass": "1.108.1",
    "social-likes-next": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "^4.2.0",
    "eslint": "^10.0.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "secretlint": "^4.2.0",
    "stylelint-config-standard-scss": "^13.1.0"
  },
  "optionalDependencies": {
    "fsevents": "2.3"
  },
  "scripts": {
    "build:front": "node scripts/build-frontend.mjs",
    "eslint": "eslint .",
    "eslint-fix": "eslint --fix .",
    "stylelint": "npx stylelint **/*.css"
  },
  "private": true
}
