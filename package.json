{
  "name": "nabla-servers-bower-sample",
  "description": "Bower sample",
  "branchVersion": "^1.0.6",
  "branchPattern": "1.0.*",
  "version": "1.0.6",
  "keywords": [
    "nabla"
  ],
  "author": "Alban Andrieu <alban.andrieu@free.fr> (http://albandrieu.com)",
  "license": "MIT",
  "licenses": [
    {
      "type": "MIT",
      "url": "http://www.opensource.org/licenses/MIT"
    }
  ],
  "homepage": "http://albandrieu.com",
  "repository": "https://github.com/AlbanAndrieu/nabla-servers-bower-sample",
  "files": [
    "lib",
    "dist",
    "contrib"
  ],
  "bugs": {
    "url": "https://github.com/AlbanAndrieu/nabla-servers-bower-sample/issues"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=8.5.5",
    "yarn": " >=1.22.0",
    "node-gyp": ">=3.0.3",
    "grunt": ">=1.6.1"
  },
  "engine-strict": true,
  "eslintConfig": {
    "parserOptions": {
      "ecmaVersion": 6
    },
    "plugins": [
      "compat"
    ],
    "rules": {
      "compat/compat": "warn"
    }
  },
  "stylelint": {
    "plugins": [
      "stylelint-no-unsupported-browser-features"
    ],
    "rules": {
      "plugin/no-unsupported-browser-features": true
    },
    "defaultSeverity": "warning"
  },
  "dependencies": {
    "bootstrap": "5.3.9",
    "font-awesome": "4.7.0",
    "github-fork-ribbon-css": "0.2.3",
    "sass": "1.108.1",
    "social-likes-next": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "^4.2.0",
    "eslint": "^10.0.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "secretlint": "^4.2.0",
    "stylelint-config-standard-scss": "^13.1.0"
  },
  "optionalDependencies": {
    "fsevents": "2.3"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "scripts": {
    "build:front": "node scripts/build-frontend.mjs",
    "eslint": "eslint .",
    "eslint-fix": "eslint --fix .",
    "stylelint": "npx stylelint **/*.css"
  },
  "private": true
}
